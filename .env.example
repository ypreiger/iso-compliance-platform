# Copy to .env (never commit). Used by scripts/playbooks and AAP credentials.
ACS_URL=https://central-acs.apps.example.com
ACS_TOKEN=
ACS_VALIDATE_CERTS=false

AAP_URL=https://demo-aap-aap.apps.example.com
AAP_API_BASE=https://demo-aap-aap.apps.example.com/api/controller/v2
CONTROLLER_HOST=https://demo-aap-aap.apps.example.com
CONTROLLER_USERNAME=admin
CONTROLLER_PASSWORD=
CONTROLLER_VERIFY_SSL=false
AAP_TOKEN=

# Optional SMTP for UC-10. If unset, notifications append to audit/notifications.log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Git write for JT-05 audit commits (AAP credential / local). Public clone works without this.
GIT_REPO_URL=https://github.com/ypreiger/iso-compliance-platform.git
GIT_BRANCH=main
GIT_TOKEN=

# Demo persona passwords (AAP local users)
AAP_USER_ALICE_PASSWORD=
AAP_USER_BOB_PASSWORD=
AAP_USER_CAROL_PASSWORD=
AAP_USER_SRE_PASSWORD=
