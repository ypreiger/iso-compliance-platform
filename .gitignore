# Local / secrets
.env
.env.*
!.env.example
*.token
**/*.token
**/gcp-sa.json
**/gcp-credentials.json
**/*-sa-key.json
**/service-account*.json
!**/*.example
!**/*.example.*

# Ansible Galaxy installs (keep requirements.yml)
collections/ansible_collections/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
.next/
apps/iso-web/dist/
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp

# OS / Office autosave locks
.DS_Store
**/.DS_Store
**/~$*
**/.~lock.*

# Generated exports (samples)
*.docx
*.xlsx
!docs/samples/**
!RAG/**/*.docx
# Accidental local working copies — never commit
RAG/**/*HEaaa*
RAG/**/*.rtf

# Kubernetes secrets (never commit real values)
**/secrets/*.yaml
!**/secrets/*.example.yaml
