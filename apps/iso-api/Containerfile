FROM registry.access.redhat.com/ubi9/python-311:latest

USER root
RUN dnf install -y xmlsec1 xmlsec1-openssl gcc make \
    && dnf clean all
COPY vendor/antiword-0.37 /tmp/antiword-0.37
RUN make -C /tmp/antiword-0.37 && make -C /tmp/antiword-0.37 global_install \
    && rm -rf /tmp/antiword-0.37

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app

ENV PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
